# Meshtastic gateway node
MESHTASTIC_PORT=COM3
# Configure this channel on every radio with a private PSK; 0 is the primary channel index.
FIRETOWER_CHANNEL_INDEX=0
# Do not pin a ticket to a node position older than this many seconds.
FIRETOWER_MAX_POSITION_AGE_SECONDS=1800
# A sender's reply after this many seconds is no longer treated as an answer
# to a pending clarification question (!ai follow-up flow).
FIRETOWER_CLARIFICATION_TTL_SECONDS=600
# Gap between the ack and the clarification question — two RELIABLE sends
# back-to-back can collide on the half-duplex radio (confirmed live).
FIRETOWER_CLARIFICATION_SEND_DELAY_SECONDS=5
# Overrides the gateway's reply prefix (normally read from the device's own
# longName at startup). Only needed for a gateway with no connected radio.
FIRETOWER_GATEWAY_NAME=Firetower

# Model calls (triage extraction, clarification questions, !ai, SITREP
# selection) go to DigitalOcean. If these are unset, the link is offline, or
# the call fails, Firetower uses keyword-only triage, the static clarification
# template, or the !ai unavailable reply. No local Ollama model is used.
DIGITALOCEAN_API_KEY=
DIGITALOCEAN_MODEL=openai-gpt-oss-20b
DIGITALOCEAN_BASE_URL=

# Online/offline probe. This is a reachability check, not a model call.
HEALTHCHECK_HOST=https://api.ollama.com
HEALTHCHECK_INTERVAL_SECONDS=5
HEALTHCHECK_TIMEOUT_SECONDS=3

# Snowflake sync + RAG (fill in only if the Snowflake track is in). Scaffolded
# but not wired into the live pipeline yet — see snowflake_rag.py.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_RAG_TABLE=ticket_context

# Voice (base station only, never over the mesh)
ELEVENLABS_API_KEY=

# Local storage
FIRETOWER_DB_PATH=data/firetower.db

# Set to 1 to serve fixtures/mock_tickets.json instead of the real DB,
# so the board/frontend can be built before db.py/triage.py are done.
FIRETOWER_MOCK=0

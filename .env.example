# Meshtastic gateway node
MESHTASTIC_PORT=COM3

# Local model (always available, used for triage)
OLLAMA_HOST=http://127.0.0.1:11434
TRIAGE_MODEL=qwen3:4b
TRIAGE_MODEL_BACKUP=llama3.2:3b

# Online-only SITREP tier
DIGITALOCEAN_API_KEY=
DIGITALOCEAN_MODEL=openai-gpt-oss-20b
HOME_OLLAMA_HOST=http://100.x.x.x:11434

# Online/offline probe
HEALTHCHECK_HOST=https://api.ollama.com
HEALTHCHECK_INTERVAL_SECONDS=5
HEALTHCHECK_TIMEOUT_SECONDS=3

# Snowflake sync (fill in only if Snowflake track is in)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Voice (base station only, never over the mesh)
ELEVENLABS_API_KEY=

# Local storage
FIRETOWER_DB_PATH=data/firetower.db

# Set to 1 to serve fixtures/mock_tickets.json instead of the real DB,
# so the board/frontend can be built before db.py/triage.py are done.
FIRETOWER_MOCK=0
